{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "jsx": "react-jsx",
    "types": ["react", "react-dom", "vite/client"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
